% Add your publications here in standard BibTeX format.
% Each entry becomes an entry on your /publications/ page automatically.
%
% Useful optional fields (see docs/CUSTOMIZE.md for the full list):
%   abbr        - short venue tag shown as a badge, e.g. {NeurIPS}
%   abstract    - shown in a collapsible "Abstract" toggle
%   pdf         - filename in assets/pdf/, or a full URL
%   selected    - set to {true} to feature it on the about page
%   preview     - filename in assets/img/ for a thumbnail
%
% Example:
%
% @article{example2026,
%   title     = {Title of the Paper},
%   author    = {Your Name and Coauthor Name},
%   journal   = {Journal or Working Paper},
%   year      = {2026},
%   abbr      = {Working Paper},
%   selected  = {true},
%   abstract  = {One or two sentence summary of the paper.},
%   pdf       = {your_paper.pdf}
% }
